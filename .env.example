# Google Maps
# Aynı anahtar kullanılabilir; Application restriction = None veya IP (sunucu) + referrer (tarayıcı) birlikte zor
# API Library’de etkin: Routes API (süre) + Maps Embed API (harita) — anahtar kısıtına eklemek yetmez, Enable şart
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Uygulama URL (SMS linkleri için)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Telefondan test (yerel IP'nizi yazın):
#   npm run dev:lan        → http://10.55.33.167:3000
#   npm run dev:lan:https  → https://10.55.33.167:3000  (GPS için; http ile açmayın)
# NEXT_PUBLIC_BASE_URL=https://10.55.33.167:3000

# Boş veritabanına demo çekici eklemek için (isteğe bağlı)
# DEMO_SEED=true

# Netgsm SMS — XML POST (https://www.netgsm.com.tr/dokuman/#xml-post-sms-gonderme)
# usercode: panel Kullanıcı Adı (cep no) — Abone No değil!
# password: API alt kullanıcı şifresi
# msgheader: onaylı gönderici adı (ör. YSN YAZILIM)
NETGSM_USERCODE=537xxxxxxx
NETGSM_USERNAME=537xxxxxxx
NETGSM_PASSWORD=api_sifreniz
NETGSM_MSGHEADER=ACILCOZUM
NETGSM_APPNAME=acilcozumbul
