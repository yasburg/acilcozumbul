# Supabase — panel girişi + tüm uygulama verisi (çekici, talep, OTP, SMS)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Sunucu only — asla NEXT_PUBLIC_ yapmayın, tarayıcıya vermeyin
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# İsteğe bağlı: talep / OTP fraud limitleri
# TALEP_FRAUD_TELEFON_LIMIT=3
# TALEP_FRAUD_TELEFON_PENCERE_SAAT=24
# TALEP_FRAUD_IP_LIMIT=10
# TALEP_FRAUD_IP_PENCERE_SAAT=1
# OTP_FRAUD_IP_LIMIT=8
# OTP_FRAUD_IP_PENCERE_DK=60
# SMS_HATA_ALARM_YUZDE=20
# SMS_HATA_ALARM_MIN=10
# SQL: supabase/migrations/012_fraud_funnel_musaitlik.sql
# Yerel data/*.json aktarımı: npm run migrate:supabase
# İsteğe bağlı: sadece bu e-postalar panele girebilir (virgülle)
# PANEL_ADMIN_EMAILS=admin@example.com

# Google Maps
# Aynı anahtar kullanılabilir; Application restriction = None veya IP (sunucu) + referrer (tarayıcı) birlikte zor
# API Library’de etkin: Routes API (süre) + Maps Embed API (harita) + Places API (New) (hedef önerileri, açık işletme)
# Anahtar kısıtına eklemek yetmez, Enable şart
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PostHog (analitik; çerez onayı sonrası aktif olur)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_tpA4yHjeJbkPL24VrMUX77teFfUm8W9NgKsqQXFuKMbP
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4 (gtag; çerez onayı + consent mode)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RX7B85YF1D
# Google Ads dönüşüm (Fiyat teklifi isteyin ACB)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18328392362
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AW-18328392362/Msc0CNjLnNMcEKql1KNE
# Google Ads dönüşüm (Kaydolma işlemi — /cekici/kayit/onay)
# NEXT_PUBLIC_GOOGLE_ADS_KAYDOLMA_LABEL=AW-18328392362/Y9juCP_Rm9McEKql1KNE
# Meta (Facebook) Pixel
# NEXT_PUBLIC_META_PIXEL_ID=1552497653179792
# TikTok Pixel (tarayıcı) + Events API (sunucu)
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=D9IAJJJC77U13TU252RG
# TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Uygulama URL (SMS linkleri için)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# SMS linkleri yerel/LAN IP yerine www canlı domain kullanır (src/lib/sms-base-url.ts).
# Önemli: apex (acilcozumbul.com www'süz) Squarespace'e gider; SMS yolları www olmalı.
# İsteğe bağlı override:
# SMS_BASE_URL=https://www.acilcozumbul.com
# Yabancı numara mesajında gösterilir (isteğe bağlı)
# NEXT_PUBLIC_DESTEK_EMAIL=destek@acilcozumbul.com
# Telefondan test (yerel IP'nizi yazın):
#   npm run dev:lan        → http://10.55.33.167:3000
#   npm run dev:lan:https  → https://10.55.33.167:3000  (GPS için; http ile açmayın)
# NEXT_PUBLIC_BASE_URL=https://10.55.33.167:3000

# Boş veritabanına demo çekici eklemek için (isteğe bağlı)
# DEMO_SEED=true

# Memnuniyet formu: anlaşmadan kaç dk sonra (şimdilik test: 1; canlıda 120 = 2 saat)
MEMNUNIYET_BEKLE_DK=1
# Cron: toplu memnuniyet SMS (Railway scheduled job, her 5–10 dk)
# CRON_SECRET=uzun-rastgele-sifre
# Ayrıca: POST /api/cron/toplu-sms (arka plan toplu SMS kuyruğu; her 1–2 dk önerilir)

# Netgsm SMS — XML POST (https://www.netgsm.com.tr/dokuman/#xml-post-sms-gonderme)
# usercode: panel Kullanıcı Adı (cep no) — Abone No değil!
# password: API alt kullanıcı şifresi
# msgheader: onaylı gönderici adı (ör. YSN YAZILIM)
# OTP ve talep SMS — bunlar yoksa doğrulama kodu gitmez (yalnızca OTP_DEV_FALLBACK ile test)
NETGSM_USERCODE=537xxxxxxx
NETGSM_USERNAME=537xxxxxxx
NETGSM_PASSWORD=api_sifreniz
NETGSM_MSGHEADER=ACILCOZUM
NETGSM_APPNAME=acilcozumbul
# Doğrulama + Premium talep SMS → Netgsm OTP SMS (REST v2 /sms/rest/v2/otp)
# Diğer müşteri SMS’leri klasik XML. OTP paketi Netgsm panelinde tanımlı olmalı.
# OTP_DEV_FALLBACK=1

