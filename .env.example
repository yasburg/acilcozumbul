# Uygulama URL (SMS linkleri için)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Netgsm SMS (Türkiye — önerilen)
# Netgsm panel: API alt kullanıcısı + onaylı gönderici adı (msgheader) gerekir
NETGSM_USERNAME=850xxxxxxx
NETGSM_PASSWORD=api_sifreniz
NETGSM_MSGHEADER=ACILCOZUM
NETGSM_APPNAME=acilcozumbul
