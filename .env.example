# Supabase — panel girişi + tüm uygulama verisi (çekici, talep, OTP, SMS)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Sunucu only — asla NEXT_PUBLIC_ yapmayın, tarayıcıya vermeyin
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SQL: supabase/migrations/001_initial.sql → SQL Editor'da çalıştırın
# Yerel data/*.json aktarımı: npm run migrate:supabase
# İsteğe bağlı: sadece bu e-postalar panele girebilir (virgülle)
# PANEL_ADMIN_EMAILS=admin@example.com

# Google Maps
# Aynı anahtar kullanılabilir; Application restriction = None veya IP (sunucu) + referrer (tarayıcı) birlikte zor
# API Library’de etkin: Routes API (süre) + Maps Embed API (harita) — anahtar kısıtına eklemek yetmez, Enable şart
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Uygulama URL (SMS linkleri için)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Yabancı numara mesajında gösterilir (isteğe bağlı)
# NEXT_PUBLIC_DESTEK_EMAIL=destek@acilcozumbul.com
# Telefondan test (yerel IP'nizi yazın):
#   npm run dev:lan        → http://10.55.33.167:3000
#   npm run dev:lan:https  → https://10.55.33.167:3000  (GPS için; http ile açmayın)
# NEXT_PUBLIC_BASE_URL=https://10.55.33.167:3000

# Boş veritabanına demo çekici eklemek için (isteğe bağlı)
# DEMO_SEED=true

# Memnuniyet formu: anlaşmadan kaç dk sonra (şimdilik test: 1; canlıda 120 = 2 saat)
MEMNUNIYET_BEKLE_DK=1
# Cron: toplu memnuniyet SMS (Railway scheduled job, her 5–10 dk)
# CRON_SECRET=uzun-rastgele-sifre

# Netgsm SMS — XML POST (https://www.netgsm.com.tr/dokuman/#xml-post-sms-gonderme)
# usercode: panel Kullanıcı Adı (cep no) — Abone No değil!
# password: API alt kullanıcı şifresi
# msgheader: onaylı gönderici adı (ör. YSN YAZILIM)
NETGSM_USERCODE=537xxxxxxx
NETGSM_USERNAME=537xxxxxxx
NETGSM_PASSWORD=api_sifreniz
NETGSM_MSGHEADER=ACILCOZUM
NETGSM_APPNAME=acilcozumbul
